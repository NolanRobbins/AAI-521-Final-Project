# Copy to .env (gitignored) or export in your shell.
# Root for datasets, manifests and checkpoints. Keep it OUTSIDE OneDrive/Dropbox
# folders -- the raw corpus is several GB. On Colab use a Google Drive path, e.g.
# /content/drive/MyDrive/aai521_data
AAI521_DATA_ROOT=C:/Users/<you>/aai521_data

# Optional: where Hugging Face caches model weights (defaults to ~/.cache/huggingface)
# HF_HOME=C:/Users/<you>/.cache/huggingface
